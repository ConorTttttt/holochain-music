+    #[tokio::test]
+    async fn disconnect_fails_pending_incoming_and_invalid_answer_is_error() {
+        let relay = CallRemoteRelay::new();
+        let proxy = AgentProxyManager::new();
+        let store = AuthStore::new();
+        relay.set_auth_store(store.clone());
+        let (sk, a) = key(1);
+        let (_, b) = key(2);
+        store
+            .add_agent(crate::auth::types::AllowedAgent {
+                agent_pubkey: b.clone(),
+                capabilities: [Capability::CallRemoteReceive].into_iter().collect(),
+                label: None,
+            })
+            .await;
+        let (b_tx, mut b_rx) = socket().await;
+        proxy.register(dna(9), b.clone(), b_tx.clone()).await;
+        let p = params(&a, &dna(9), &b, now_us() + 60_000_000);
+        let (bytes, sig) = signed(&sk, &p);
+        let (r2, p2, b2, by2, s2) = (
+            relay.clone(),
+            proxy.clone(),
+            b.clone(),
+            bytes.clone(),
+            sig.clone(),
+        );
+        let task =
+            tokio::spawn(async move { r2.deliver_incoming(&p2, &dna(9), &b2, by2, s2).await });
+        let _ = b_rx.recv().await.unwrap();
+        relay.drop_socket(&b_tx).await;
+        assert!(task.await.unwrap().unwrap_err().contains("disconnected"));
+        // Garbage answer -> error, never a success.
+        let (r2, p2, b2) = (relay.clone(), proxy.clone(), b.clone());
+        let task =
+            tokio::spawn(async move { r2.deliver_incoming(&p2, &dna(9), &b2, bytes, sig).await });
+        let ServerMessage::CallRemoteIncoming { request_id, .. } = b_rx.recv().await.unwrap()
+        else {
+            panic!()
+        };
+        assert!(
+            relay
+                .complete_incoming(&request_id, Some(&b), &b_tx, Ok(vec![1, 2, 3]))
+                .await
+        );
+        assert!(task.await.unwrap().is_err());
+    }
