@@ -0,0 +1,107 @@
+//! `POST /call_remote/{dna_hash}`: outgoing standard Holochain call_remote
+//! for the authenticated session agent. See `crate::call_remote`.
+
+use crate::auth::types::AuthContext;
+use crate::call_remote::CallRemoteError;
+use crate::service::AppState;
+use axum::extract::{Path, State};
+use axum::http::StatusCode;
+use axum::response::{IntoResponse, Response};
+use axum::{Extension, Json};
+use base64::Engine;
+use holochain_types::prelude::{AgentPubKey, DnaHash};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Deserialize)]
+pub struct CallRemoteRequest {
+    /// Target agent (HoloHash string).
+    pub target_agent: String,
+    /// base64 of the exact signed `ZomeCallParams` bytes.
+    pub zome_call_params: String,
+    /// base64 Ed25519 signature over sha2_512(zome_call_params).
+    pub signature: String,
+}
+
+#[derive(Debug, Serialize)]
+pub struct CallRemoteReply {
+    /// base64 msgpack `ZomeCallResponse` exactly as returned by the recipient.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub response: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub error: Option<String>,
+}
+
+fn reply(status: StatusCode, error: String) -> Response {
+    (
+        status,
+        Json(CallRemoteReply {
+            response: None,
+            error: Some(error),
+        }),
+    )
+        .into_response()
+}
+
+pub async fn call_remote_send(
+    Path(dna_hash): Path<String>,
+    State(state): State<AppState>,
+    auth: Option<Extension<AuthContext>>,
+    Json(body): Json<CallRemoteRequest>,
+) -> Response {
+    // Only reachable through the authenticated router; fail closed otherwise.
+    let Some(Extension(auth)) = auth else {
+        return reply(
+            StatusCode::UNAUTHORIZED,
+            "authenticated session required".into(),
+        );
+    };
+    let Ok(dna) = DnaHash::try_from(dna_hash.as_str()) else {
+        return reply(StatusCode::BAD_REQUEST, "invalid DNA hash".into());
+    };
+    if !auth.has_dna(&dna) {
+        return reply(StatusCode::FORBIDDEN, "DNA not in session scope".into());
+    }
+    let Ok(target) = AgentPubKey::try_from(body.target_agent.as_str()) else {
+        return reply(StatusCode::BAD_REQUEST, "invalid target agent".into());
+    };
+    let engine = base64::engine::general_purpose::STANDARD;
+    let (Ok(bytes), Ok(signature)) = (
+        engine.decode(&body.zome_call_params),
+        engine.decode(&body.signature),
+    ) else {
+        return reply(StatusCode::BAD_REQUEST, "invalid base64".into());
+    };
+    let relay = state.agent_proxy.call_remote().clone();
+    match relay
+        .send(
+            &state.agent_proxy,
+            &auth.agent_pubkey,
+            &dna,
+            &target,
+            bytes,
+            signature,
+        )
+        .await
+    {
+        Ok(response) => (
+            StatusCode::OK,
+            Json(CallRemoteReply {
+                response: Some(engine.encode(response)),
+                error: None,
+            }),
+        )
+            .into_response(),
+        Err(e) => {
+            let status = match &e {
+                CallRemoteError::Malformed(_) => StatusCode::BAD_REQUEST,
+                CallRemoteError::Forbidden(_) => StatusCode::FORBIDDEN,
+                CallRemoteError::Busy(_) => StatusCode::TOO_MANY_REQUESTS,
+                CallRemoteError::Unreachable(_) | CallRemoteError::Remote(_) => {
+                    StatusCode::BAD_GATEWAY
+                }
+                CallRemoteError::Timeout => StatusCode::GATEWAY_TIMEOUT,
+            };
+            reply(status, e.to_string())
+        }
+    }
+}
