+
+    fn key(seed: u8) -> (SigningKey, AgentPubKey) {
+        let sk = SigningKey::from_bytes(&[seed; 32]);
+        let agent = AgentPubKey::from_raw_32(sk.verifying_key().to_bytes().to_vec());
+        (sk, agent)
+    }
+
+    fn dna(id: u8) -> DnaHash {
+        DnaHash::from_raw_32(vec![id; 32])
+    }
+
+    fn params(from: &AgentPubKey, dna: &DnaHash, to: &AgentPubKey, exp_us: i64) -> ZomeCallParams {
+        ZomeCallParams {
+            provenance: from.clone(),
+            cell_id: CellId::new(dna.clone(), to.clone()),
+            zome_name: ZomeName::from("music_storage"),
+            fn_name: FunctionName::from("receive_grant"),
+            cap_secret: None,
+            payload: ExternIO::encode("hello").unwrap(),
+            nonce: Nonce256Bits::from([7u8; 32]),
+            expires_at: Timestamp::from_micros(exp_us),
+        }
+    }
+
+    fn signed(sk: &SigningKey, p: &ZomeCallParams) -> (Vec<u8>, Vec<u8>) {
+        let (bytes, hash) = p.serialize_and_hash().unwrap();
+        (bytes, sk.sign(&hash).to_bytes().to_vec())
+    }
+
+    #[test]
+    fn native_signature_verifies_and_blake2b_or_raw_scheme_does_not() {
+        let (sk, a) = key(1);
+        let (_, b) = key(2);
+        let p = params(&a, &dna(9), &b, now_us() + 60_000_000);
+        let (bytes, sig) = signed(&sk, &p);
+        assert!(verify_signed_params(&bytes, &sig).is_ok());
+        // Signing the raw bytes (not sha2_512) must be rejected.
+        let raw = sk.sign(&bytes).to_bytes().to_vec();
+        assert!(matches!(
+            verify_signed_params(&bytes, &raw),
+            Err(CallRemoteError::Forbidden(_))
+        ));
+    }
+
+    #[test]
+    fn forged_signature_and_tampered_bytes_rejected() {
+        let (sk_a, a) = key(1);
+        let (sk_m, _) = key(3);
+        let (_, b) = key(2);
+        let p = params(&a, &dna(9), &b, now_us() + 60_000_000);
+        let (bytes, _) = signed(&sk_a, &p);
+        let (_, forged) = signed(&sk_m, &p);
+        assert!(verify_signed_params(&bytes, &forged).is_err());
+        let (mut bytes2, sig) = signed(&sk_a, &p);
+        let last = bytes2.len() - 1;
+        bytes2[last] ^= 1;
+        assert!(verify_signed_params(&bytes2, &sig).is_err());
+        assert!(verify_signed_params(&bytes, &sig[..63]).is_err());
+    }
+
+    #[test]
+    fn outgoing_provenance_cell_target_and_expiry_enforced() {
+        let (_, a) = key(1);
+        let (_, b) = key(2);
+        let (_, m) = key(3);
+        let now = now_us();
+        let p = params(&a, &dna(9), &b, now + 60_000_000);
+        assert!(check_outgoing(&p, &a, &dna(9), &b, now).is_ok());
+        // Impersonation: session is m, params claim a.
+        assert!(check_outgoing(&p, &m, &dna(9), &b, now).is_err());
+        // Wrong DNA / target.
+        assert!(check_outgoing(&p, &a, &dna(8), &b, now).is_err());
+        assert!(check_outgoing(&p, &a, &dna(9), &m, now).is_err());
+        // Expired and far future.
+        let p = params(&a, &dna(9), &b, now - 1);
+        assert!(check_outgoing(&p, &a, &dna(9), &b, now).is_err());
+        let p = params(&a, &dna(9), &b, now + WITNESSABLE_EXPIRY_US + 1_000_000);
+        assert!(check_outgoing(&p, &a, &dna(9), &b, now).is_err());
+        // Self call.
+        let p = params(&a, &dna(9), &a, now + 60_000_000);
+        assert!(check_outgoing(&p, &a, &dna(9), &a, now).is_err());
