+    #[tokio::test]
+    async fn response_routing_bound_to_peer() {
+        let relay = CallRemoteRelay::new();
+        let (_, a) = key(1);
+        let peer = Url::from_str("ws://127.0.0.1:1").unwrap();
+        let other = Url::from_str("ws://127.0.0.1:2").unwrap();
+        let (tx, mut rx) = oneshot::channel();
+        relay.inner.out.lock().await.insert(
+            5,
+            PendingOut {
+                peer: peer.clone(),
+                agent: a,
+                tx,
+            },
+        );
+        let msg = WireMessage::ErrorRes {
+            msg_id: 5,
+            error: "x".into(),
+        };
+        assert!(relay.route_response(msg, &other).await.is_ok());
+        assert!(
+            rx.try_recv().is_err(),
+            "wrong peer must not resolve the call"
+        );
+        let msg = WireMessage::ErrorRes {
+            msg_id: 5,
+            error: "x".into(),
+        };
+        assert!(relay.route_response(msg, &peer).await.is_ok());
+        assert!(rx.try_recv().is_ok());
+        // Unknown ids are handed back for DHT routing.
+        let msg = WireMessage::ErrorRes {
+            msg_id: 6,
+            error: "x".into(),
+        };
+        assert!(relay.route_response(msg, &peer).await.is_err());
+    }
