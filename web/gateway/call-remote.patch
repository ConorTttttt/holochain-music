@@ -0,0 +1,873 @@
+//! Standard Holochain `call_remote` for browser (HWC) agents.
+//!
+//! Outgoing (browser agent -> any agent): `POST /call_remote/{dna_hash}` with a
+//! bearer session holding [`Capability::CallRemoteSend`]. The browser signs
+//! `ZomeCallParams` itself (Ed25519 over `sha2_512(encode(params))`, exactly as
+//! `ZomeCallParamsSigned::try_from_params` in Holochain 0.7). The gateway never
+//! signs: it checks that the provenance is the session's authenticated agent,
+//! that the cell is `(dna, target)`, that the signature verifies and the expiry
+//! is witnessable, then sends a native `WireMessage::CallRemoteReq` and returns
+//! the native `CallRemoteRes` bytes (a msgpack `ZomeCallResponse`) unchanged.
+//!
+//! Incoming (any agent -> browser agent): a native `CallRemoteReq` addressed to
+//! a browser agent registered on this gateway is forwarded ONLY to that agent's
+//! current authenticated WebSocket when the operator granted
+//! [`Capability::CallRemoteReceive`]. The browser re-verifies everything
+//! (signature, cell, nonce, capability grant) before executing; the gateway
+//! check here is defence in depth and load shedding, not the trust root. The
+//! browser's reply must come from the same agent on the same socket and must
+//! decode as a `ZomeCallResponse`; it is returned as `CallRemoteRes`. Timeouts,
+//! disconnects and refusals become `ErrorRes` (the native caller sees
+//! `ZomeCallResponse::NetworkError`), never a fabricated success.
+//!
+//! Responses are correlated by `msg_id` AND the peer URL the request was sent
+//! to, so another peer cannot answer a call it was not asked.
+
+use crate::agent_proxy::{AgentProxyManager, WsSender};
+use crate::auth::types::Capability;
+use crate::auth::AuthStore;
+use crate::gateway_kitsune::GatewayKitsune;
+use crate::routes::websocket::ServerMessage;
+use base64::Engine;
+use holochain_p2p::WireMessage;
+use holochain_serialized_bytes::{SerializedBytes, UnsafeBytes};
+use holochain_types::prelude::{
+    AgentPubKey, DnaHash, ExternIO, Signature, Timestamp, ZomeCallParams, ZomeCallResponse,
+};
+use kitsune2_api::Url;
+use std::collections::{HashMap, VecDeque};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, OnceLock};
+use std::time::{Duration, Instant};
+use tokio::sync::{oneshot, Mutex};
+
+/// Largest accepted serialized `ZomeCallParams` (Music grants are < 8 KiB).
+pub const MAX_PARAMS_BYTES: usize = 32 * 1024;
+/// Largest accepted serialized `ZomeCallResponse` from a browser.
+pub const MAX_RESPONSE_BYTES: usize = 32 * 1024;
+/// Largest WebSocket text frame accepted for `call_remote_response` (base64 + JSON).
+pub const MAX_RESPONSE_FRAME_BYTES: usize = 48 * 1024;
+/// Holochain's `WITNESSABLE_EXPIRY_DURATION` (50 minutes).
+const WITNESSABLE_EXPIRY_US: i64 = 50 * 60 * 1_000_000;
+/// Outgoing request timeout: below HWC's 30 s synchronous network wait.
+pub const OUTGOING_TIMEOUT: Duration = Duration::from_secs(25);
+/// Time a browser recipient has to answer an incoming call.
+pub const INCOMING_TIMEOUT: Duration = Duration::from_secs(30);
+const MAX_PENDING_OUT: usize = 256;
+const MAX_PENDING_OUT_PER_AGENT: usize = 4;
+const MAX_PENDING_IN: usize = 256;
+const MAX_PENDING_IN_PER_AGENT: usize = 8;
+const RATE_WINDOW: Duration = Duration::from_secs(60);
+const MAX_OUT_PER_WINDOW: usize = 30;
+const MAX_IN_PER_WINDOW: usize = 60;
+
+/// Why a call was refused or failed. The text is returned to the caller.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CallRemoteError {
+    Malformed(String),
+    Forbidden(String),
+    Busy(String),
+    Unreachable(String),
+    Remote(String),
+    Timeout,
+}
+
+impl std::fmt::Display for CallRemoteError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Malformed(m) => write!(f, "call_remote malformed: {m}"),
+            Self::Forbidden(m) => write!(f, "call_remote forbidden: {m}"),
+            Self::Busy(m) => write!(f, "call_remote busy: {m}"),
+            Self::Unreachable(m) => write!(f, "call_remote unreachable: {m}"),
+            Self::Remote(m) => write!(f, "{m}"),
+            Self::Timeout => write!(f, "call_remote timed out"),
+        }
+    }
+}
+
+fn now_us() -> i64 {
+    Timestamp::now().as_micros()
+}
+
+/// Decode signed `ZomeCallParams` exactly as `Cell::handle_call_remote` does,
+/// additionally requiring canonical encoding, and verify the Ed25519 signature
+/// by the provenance over `sha2_512(bytes)`.
+pub fn verify_signed_params(
+    bytes: &[u8],
+    signature: &[u8],
+) -> Result<ZomeCallParams, CallRemoteError> {
+    if bytes.len() > MAX_PARAMS_BYTES {
+        return Err(CallRemoteError::Malformed(
+            "zome call params too large".into(),
+        ));
+    }
+    let params: ZomeCallParams = holochain_serialized_bytes::decode(bytes)
+        .map_err(|_| CallRemoteError::Malformed("undecodable zome call params".into()))?;
+    let (canonical, digest) = params
+        .serialize_and_hash()
+        .map_err(|_| CallRemoteError::Malformed("unencodable zome call params".into()))?;
+    if canonical != bytes {
+        return Err(CallRemoteError::Malformed(
+            "non-canonical zome call params".into(),
+        ));
+    }
+    let sig: [u8; 64] = signature
+        .try_into()
+        .map_err(|_| CallRemoteError::Malformed("signature must be 64 bytes".into()))?;
+    let raw: [u8; 32] = params
+        .provenance
+        .get_raw_32()
+        .try_into()
+        .map_err(|_| CallRemoteError::Malformed("bad provenance".into()))?;
+    let key = ed25519_dalek::VerifyingKey::from_bytes(&raw)
+        .map_err(|_| CallRemoteError::Forbidden("provenance is not an Ed25519 key".into()))?;
+    key.verify_strict(&digest, &ed25519_dalek::Signature::from_bytes(&sig))
+        .map_err(|_| {
+            CallRemoteError::Forbidden("signature does not verify for provenance".into())
+        })?;
+    Ok(params)
+}
+
+/// Outgoing checks: the session may only send calls it signed itself, for
+/// exactly `(dna, target)`, with an expiry the recipient can witness.
+pub fn check_outgoing(
+    params: &ZomeCallParams,
+    session_agent: &AgentPubKey,
+    dna: &DnaHash,
+    target: &AgentPubKey,
+    now_us: i64,
+) -> Result<(), CallRemoteError> {
+    if &params.provenance != session_agent {
+        return Err(CallRemoteError::Forbidden(
+            "provenance is not the authenticated session agent".into(),
+        ));
+    }
+    if params.cell_id.dna_hash() != dna || params.cell_id.agent_pubkey() != target {
+        return Err(CallRemoteError::Forbidden(
+            "cell does not match DNA and target agent".into(),
+        ));
+    }
+    if target == session_agent {
+        return Err(CallRemoteError::Forbidden(
+            "cannot call_remote yourself".into(),
+        ));
+    }
+    check_expiry(params, now_us)
+}
+
+fn check_expiry(params: &ZomeCallParams, now_us: i64) -> Result<(), CallRemoteError> {
+    let exp = params.expires_at.as_micros();
+    if exp <= now_us {
+        return Err(CallRemoteError::Forbidden("zome call expired".into()));
+    }
+    if exp > now_us + WITNESSABLE_EXPIRY_US {
+        return Err(CallRemoteError::Forbidden(
+            "zome call expiry too far in the future".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Incoming checks performed before anything reaches a browser.
+pub fn check_incoming(
+    params: &ZomeCallParams,
+    dna: &DnaHash,
+    to_agent: &AgentPubKey,
+    now_us: i64,
+) -> Result<(), CallRemoteError> {
+    if params.cell_id.dna_hash() != dna || params.cell_id.agent_pubkey() != to_agent {
+        return Err(CallRemoteError::Forbidden(
+            "call is for a different cell".into(),
+        ));
+    }
+    check_expiry(params, now_us)
+}
+
+/// A browser's answer must be a single msgpack `ZomeCallResponse`.
+pub fn check_response(bytes: &[u8]) -> Result<(), CallRemoteError> {
+    if bytes.len() > MAX_RESPONSE_BYTES {
+        return Err(CallRemoteError::Malformed("response too large".into()));
+    }
+    let _: ZomeCallResponse = holochain_serialized_bytes::decode(bytes)
+        .map_err(|_| CallRemoteError::Malformed("response is not a ZomeCallResponse".into()))?;
+    Ok(())
+}
+
+struct PendingOut {
+    peer: Url,
+    agent: AgentPubKey,
+    tx: oneshot::Sender<WireMessage>,
+}
+
+struct PendingIn {
+    dna: DnaHash,
+    agent: AgentPubKey,
+    socket: WsSender,
+    tx: oneshot::Sender<Result<Vec<u8>, String>>,
+}
+
+#[derive(Default)]
+struct Inner {
+    out: Mutex<HashMap<u64, PendingOut>>,
+    inc: Mutex<HashMap<String, PendingIn>>,
+    rate_out: Mutex<HashMap<AgentPubKey, VecDeque<Instant>>>,
+    rate_in: Mutex<HashMap<AgentPubKey, VecDeque<Instant>>>,
+    counter: AtomicU64,
+    kitsune: OnceLock<GatewayKitsune>,
+    auth: OnceLock<AuthStore>,
+}
+
+/// Shared state of the call_remote relay (cheap to clone).
+#[derive(Clone, Default)]
+pub struct CallRemoteRelay {
+    inner: Arc<Inner>,
+}
+
+impl std::fmt::Debug for CallRemoteRelay {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("CallRemoteRelay").finish_non_exhaustive()
+    }
+}
+
+async fn take_rate(
+    map: &Mutex<HashMap<AgentPubKey, VecDeque<Instant>>>,
+    agent: &AgentPubKey,
+    max: usize,
+) -> bool {
+    let mut m = map.lock().await;
+    let now = Instant::now();
+    let q = m.entry(agent.clone()).or_default();
+    while q
+        .front()
+        .is_some_and(|t| now.duration_since(*t) > RATE_WINDOW)
+    {
+        q.pop_front();
+    }
+    if q.len() >= max {
+        return false;
+    }
+    q.push_back(now);
+    true
+}
+
+fn b64(bytes: &[u8]) -> String {
+    base64::engine::general_purpose::STANDARD.encode(bytes)
+}
+
+impl CallRemoteRelay {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Set once at service start (kitsune2 is built after the agent proxy).
+    pub fn set_kitsune(&self, kitsune: GatewayKitsune) {
+        let _ = self.inner.kitsune.set(kitsune);
+    }
+
+    /// Set once at service start. Without an auth store, incoming delivery
+    /// fails closed (no unauthenticated browser may receive calls).
+    pub fn set_auth_store(&self, store: AuthStore) {
+        let _ = self.inner.auth.set(store);
+    }
+
+    pub async fn pending_counts(&self) -> (usize, usize) {
+        (
+            self.inner.out.lock().await.len(),
+            self.inner.inc.lock().await.len(),
+        )
+    }
+
+    /// Route a `CallRemoteRes`/`ErrorRes`. Returns false (message untouched by
+    /// this relay) unless `msg_id` is ours AND it came from the peer we asked.
+    pub async fn route_response(
+        &self,
+        msg: WireMessage,
+        from_peer: &Url,
+    ) -> Result<(), WireMessage> {
+        let Some(msg_id) = msg.get_msg_id() else {
+            return Err(msg);
+        };
+        if !matches!(
+            msg,
+            WireMessage::CallRemoteRes { .. } | WireMessage::ErrorRes { .. }
+        ) {
+            return Err(msg);
+        }
+        let pending = {
+            let mut out = self.inner.out.lock().await;
+            match out.get(&msg_id) {
+                Some(p) if &p.peer == from_peer => out.remove(&msg_id),
+                Some(_) => {
+                    tracing::warn!(msg_id, %from_peer, "call_remote response from unexpected peer ignored");
+                    return Ok(());
+                }
+                None => None,
+            }
+        };
+        match pending {
+            Some(p) => {
+                let _ = p.tx.send(msg);
+                Ok(())
+            }
+            None => Err(msg),
+        }
+    }
+
+    /// Outgoing call. `bytes`/`signature` are the browser-signed params.
+    pub async fn send(
+        &self,
+        proxy: &AgentProxyManager,
+        session_agent: &AgentPubKey,
+        dna: &DnaHash,
+        target: &AgentPubKey,
+        bytes: Vec<u8>,
+        signature: Vec<u8>,
+    ) -> Result<Vec<u8>, CallRemoteError> {
+        let params = verify_signed_params(&bytes, &signature)?;
+        check_outgoing(&params, session_agent, dna, target, now_us())?;
+        if !take_rate(&self.inner.rate_out, session_agent, MAX_OUT_PER_WINDOW).await {
+            return Err(CallRemoteError::Busy("outgoing call rate limit".into()));
+        }
+        // Browser-to-browser on this gateway: deliver directly, same checks.
+        if proxy.is_registered(dna, target).await {
+            return self
+                .deliver_incoming(proxy, dna, target, bytes, signature)
+                .await
+                .map_err(CallRemoteError::Remote);
+        }
+        let kitsune = self
+            .inner
+            .kitsune
+            .get()
+            .ok_or_else(|| CallRemoteError::Unreachable("network not initialised".into()))?;
+        let space = kitsune
+            .get_or_create_space(dna)
+            .await
+            .map_err(CallRemoteError::Unreachable)?;
+        let to_url = space
+            .peer_store()
+            .get(target.to_k2_agent())
+            .await
+            .map_err(|e| CallRemoteError::Unreachable(e.to_string()))?
+            .and_then(|info| {
+                if info.is_tombstone {
+                    None
+                } else {
+                    info.url.clone()
+                }
+            })
+            .ok_or_else(|| CallRemoteError::Unreachable("no url for peer".into()))?;
+        let (msg_id, req) = WireMessage::call_remote_req(
+            target.clone(),
+            ExternIO(bytes),
+            Signature::from(
+                <[u8; 64]>::try_from(signature.as_slice())
+                    .map_err(|_| CallRemoteError::Malformed("signature".into()))?,
+            ),
+        );
+        let encoded = WireMessage::encode_batch(&[&req])
+            .map_err(|e| CallRemoteError::Malformed(e.to_string()))?;
+        let (tx, rx) = oneshot::channel();
+        {
+            let mut out = self.inner.out.lock().await;
+            if out.len() >= MAX_PENDING_OUT
+                || out.values().filter(|p| &p.agent == session_agent).count()
+                    >= MAX_PENDING_OUT_PER_AGENT
+            {
+                return Err(CallRemoteError::Busy("too many pending calls".into()));
+            }
+            out.insert(
+                msg_id,
+                PendingOut {
+                    peer: to_url.clone(),
+                    agent: session_agent.clone(),
+                    tx,
+                },
+            );
+        }
+        if let Err(e) = space.send_notify(to_url, encoded).await {
+            self.inner.out.lock().await.remove(&msg_id);
+            return Err(CallRemoteError::Unreachable(e.to_string()));
+        }
+        let result = tokio::time::timeout(OUTGOING_TIMEOUT, rx).await;
+        self.inner.out.lock().await.remove(&msg_id);
+        match result {
+            Ok(Ok(WireMessage::CallRemoteRes { response, .. })) => {
+                let bytes: Vec<u8> = UnsafeBytes::from(response).into();
+                check_response(&bytes).map_err(|_| {
+                    CallRemoteError::Remote("invalid call_remote response from peer".into())
+                })?;
+                Ok(bytes)
+            }
+            Ok(Ok(WireMessage::ErrorRes { error, .. })) => Err(CallRemoteError::Remote(error)),
+            Ok(Ok(_)) => Err(CallRemoteError::Remote(
+                "invalid response to call_remote".into(),
+            )),
+            Ok(Err(_)) => Err(CallRemoteError::Unreachable("request dropped".into())),
+            Err(_) => Err(CallRemoteError::Timeout),
+        }
+    }
+
+    /// Deliver a remote call to a browser agent hosted here and wait for its
+    /// `ZomeCallResponse` bytes. Errors are strings for `ErrorRes`.
+    pub async fn deliver_incoming(
+        &self,
+        proxy: &AgentProxyManager,
+        dna: &DnaHash,
+        to_agent: &AgentPubKey,
+        bytes: Vec<u8>,
+        signature: Vec<u8>,
+    ) -> Result<Vec<u8>, String> {
+        let params = verify_signed_params(&bytes, &signature).map_err(|e| e.to_string())?;
+        check_incoming(&params, dna, to_agent, now_us()).map_err(|e| e.to_string())?;
+        let Some(auth) = self.inner.auth.get() else {
+            return Err("call_remote unreachable: recipient cannot receive remote calls".into());
+        };
+        let allowed = auth
+            .get_agent(to_agent)
+            .await
+            .is_some_and(|a| a.capabilities.contains(&Capability::CallRemoteReceive));
+        if !allowed {
+            return Err("call_remote unreachable: recipient cannot receive remote calls".into());
+        }
+        let Some(socket) = proxy.current_sender(dna, to_agent).await else {
+            return Err("call_remote unreachable: recipient not connected".into());
+        };
+        if !take_rate(&self.inner.rate_in, &params.provenance, MAX_IN_PER_WINDOW).await {
+            return Err("call_remote busy: sender rate limited".into());
+        }
+        let request_id = format!(
+            "cr-{}-{:016x}",
+            self.inner.counter.fetch_add(1, Ordering::SeqCst),
+            rand::random::<u64>()
+        );
+        let (tx, rx) = oneshot::channel();
+        {
+            let mut inc = self.inner.inc.lock().await;
+            if inc.len() >= MAX_PENDING_IN
+                || inc.values().filter(|p| &p.agent == to_agent).count() >= MAX_PENDING_IN_PER_AGENT
+            {
+                return Err("call_remote busy: recipient has too many pending calls".into());
+            }
+            inc.insert(
+                request_id.clone(),
+                PendingIn {
+                    dna: dna.clone(),
+                    agent: to_agent.clone(),
+                    socket: socket.clone(),
+                    tx,
+                },
+            );
+        }
+        let frame = ServerMessage::CallRemoteIncoming {
+            request_id: request_id.clone(),
+            dna_hash: dna.to_string(),
+            to_agent: to_agent.to_string(),
+            zome_call_params: b64(&bytes),
+            signature: b64(&signature),
+        };
+        if socket.send(frame).await.is_err() {
+            self.inner.inc.lock().await.remove(&request_id);
+            return Err("call_remote unreachable: recipient disconnected".into());
+        }
+        let result = tokio::time::timeout(INCOMING_TIMEOUT, rx).await;
+        self.inner.inc.lock().await.remove(&request_id);
+        match result {
+            Ok(Ok(r)) => r,
+            Ok(Err(_)) => Err("call_remote unreachable: recipient disconnected".into()),
+            Err(_) => Err("call_remote timed out waiting for recipient".into()),
+        }
+    }
+
+    /// A browser answers an incoming call. Accepted only from the addressed
+    /// agent on the very socket the request was sent to; a mismatch does not
+    /// consume the pending request.
+    pub async fn complete_incoming(
+        &self,
+        request_id: &str,
+        agent: Option<&AgentPubKey>,
+        socket: &WsSender,
+        result: Result<Vec<u8>, String>,
+    ) -> bool {
+        let pending = {
+            let mut inc = self.inner.inc.lock().await;
+            match inc.get(request_id) {
+                Some(p) if Some(&p.agent) == agent && p.socket.same_channel(socket) => {
+                    inc.remove(request_id)
+                }
+                _ => None,
+            }
+        };
+        let Some(p) = pending else {
+            return false;
+        };
+        let result = match result {
+            Ok(bytes) => check_response(&bytes)
+                .map(|_| bytes)
+                .map_err(|e| e.to_string()),
+            Err(e) => Err(e.chars().take(1024).collect()),
+        };
+        tracing::debug!(dna = %p.dna, ok = result.is_ok(), "call_remote answered by browser");
+        p.tx.send(result).is_ok()
+    }
+
+    /// Socket closed or revoked: fail every call waiting on it.
+    pub async fn drop_socket(&self, socket: &WsSender) {
+        self.inner
+            .inc
+            .lock()
+            .await
+            .retain(|_, p| !p.socket.same_channel(socket));
+    }
+
+    /// Handle a native `CallRemoteReq` received by the gateway and reply to
+    /// `from_peer` with `CallRemoteRes` or `ErrorRes`.
+    #[allow(clippy::too_many_arguments)] // mirrors WireMessage::CallRemoteReq fields
+    pub async fn handle_wire_request(
+        &self,
+        proxy: AgentProxyManager,
+        dna: DnaHash,
+        from_peer: Url,
+        msg_id: u64,
+        to_agent: AgentPubKey,
+        params: ExternIO,
+        signature: Signature,
+    ) {
+        let resp = match self
+            .deliver_incoming(&proxy, &dna, &to_agent, params.0, signature.0.to_vec())
+            .await
+        {
+            Ok(bytes) => WireMessage::call_remote_res(
+                msg_id,
+                SerializedBytes::from(UnsafeBytes::from(bytes)),
+            ),
+            Err(error) => WireMessage::ErrorRes { msg_id, error },
+        };
+        let Some(kitsune) = self.inner.kitsune.get() else {
+            return;
+        };
+        let Ok(space) = kitsune.get_or_create_space(&dna).await else {
+            return;
+        };
+        match WireMessage::encode_batch(&[&resp]) {
+            Ok(encoded) => {
+                if let Err(e) = space.send_notify(from_peer, encoded).await {
+                    tracing::debug!(?e, "failed to send call_remote response");
+                }
+            }
+            Err(e) => tracing::warn!(?e, "failed to encode call_remote response"),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
