+        let b2 = b.clone();
+        let task =
+            tokio::spawn(async move { r2.deliver_incoming(&p2, &dna(9), &b2, bytes, sig).await });
+        let frame = b_rx.recv().await.unwrap();
+        let ServerMessage::CallRemoteIncoming { request_id, .. } = frame else {
+            panic!("expected call_remote_incoming");
+        };
+        assert!(
+            m_rx.try_recv().is_err(),
